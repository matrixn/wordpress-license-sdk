{
    "name": "zion/wordpress-license-sdk",
    "description": "Licensing and private update SDK for WordPress plugins.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "wordpress",
        "plugin",
        "licensing",
        "updates",
        "sdk"
    ],
    "authors": [
        {
            "name": "Alex Radu Raduta",
            "homepage": "https://zion3d.ro"
        }
    ],
    "autoload": { "psr-4": { "Zion\\WordPressLicense\\": "src/" } },
    "require": { "php": "^8.1", "firebase/php-jwt": "^7.0", "psr/log": "^3.0" },
    "require-dev": { "phpunit/phpunit": "^11.0" },
    "support": {
        "issues": "https://github.com/matrixn/wordpress-license-sdk/issues",
        "source": "https://github.com/matrixn/wordpress-license-sdk"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
